\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Pair-level gradient on the three events that carry a multi-coin wall-affected block. Entries are layer means of $\Delta \rho $, the change in peg-deviation correlation from the 60-day pre-window to the acute window \eqref  {eq:delta-rho}, with pair counts in parentheses; layers are defined in \S  \ref {sec:gradient}. $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathrm  {DiD}$}\mathaccent "0362{\mathrm  {DiD}}$ is the block-versus-rest contrast \eqref  {eq:did}. $p_{\text  {coin}}$ is the coin-level permutation (the operative test), $p_{\text  {pair}}$ the pair-level permutation reported for comparison; both are one-sided against the no-block null.}}{22}{table.2}\protected@file@percent }
\newlabel{tab:gradient}{{2}{22}{Pair-level gradient on the three events that carry a multi-coin wall-affected block. Entries are layer means of $\Delta \rho $, the change in peg-deviation correlation from the 60-day pre-window to the acute window \eqref {eq:delta-rho}, with pair counts in parentheses; layers are defined in \S \ref {sec:gradient}. $\widehat {\mathrm {DiD}}$ is the block-versus-rest contrast \eqref {eq:did}. $p_{\text {coin}}$ is the coin-level permutation (the operative test), $p_{\text {pair}}$ the pair-level permutation reported for comparison; both are one-sided against the no-block null}{table.2}{}}
\@writefile{toc}{\contentsline {paragraph}{The block effect is not a victim effect.}{22}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces The pair-level gradient test. (a) Mean change in peg-deviation correlation $\Delta \rho $ by pair layer for the three events with a multi-coin wall-affected block, with pair counts in parentheses. The criterion \eqref  {eq:gradient-prediction} holds on USDC--SVB and on FTX, and fails on FDUSD, where the BLOCK bar sits below both other layers. (b) The coin-level permutation null for the primary event: block labels are redrawn over sets of three coins and the block-versus-rest contrast recomputed for each of 20{,}000 draws. The observed contrast sits in the upper tail.}}{23}{figure.2}\protected@file@percent }
\newlabel{fig:gradient}{{2}{23}{The pair-level gradient test. (a) Mean change in peg-deviation correlation $\Delta \rho $ by pair layer for the three events with a multi-coin wall-affected block, with pair counts in parentheses. The criterion \eqref {eq:gradient-prediction} holds on USDC--SVB and on FTX, and fails on FDUSD, where the BLOCK bar sits below both other layers. (b) The coin-level permutation null for the primary event: block labels are redrawn over sets of three coins and the block-versus-rest contrast recomputed for each of 20{,}000 draws. The observed contrast sits in the upper tail}{figure.2}{}}
